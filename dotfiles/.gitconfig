[user]
	email = tpwojdat@gmail.com
	name = Tomasz Wojdat
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	verbose = true
	gpgSign = true
[tag]
	gpgSign = true
[core]
	autocrlf = input
	excludesFile = ~/.config/git/gitignore_global
	pager = less --tabs 4
[fetch]
	prune = true
[pull]
	rebase = true
[rebase]
	autosquash = true
[rerere]
	enabled = true
[merge]
	tool = nvim
	conflictstyle = zdiff3 # added in Git 2.35
[mergetool]
	keepBackup = false
	prompt = false
[mergetool "nvim"]
	cmd = "nvim -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\""
[init]
	defaultBranch = main
[blame]
	markIgnoredLines = true
	markUnblamableLines = true
[feature]
	manyFiles = false
[alias]
	git = !git
	k = !gitk &
	ka = !gitk --all &
	l = log --graph --all --oneline
	lg = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%cr)%C(reset) %C(white)%s%C(reset) %C(bold yellow)- %cn%C(reset)%C(bold red)%d%C(reset)' --abbrev-commit --date=relative
	llg = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%cD%C(reset) %C(bold green)(%cr)%C(reset)%C(bold yellow)%d%C(reset)%n'' %C(white)%s%C(reset) %C(bold yellow)- %cn%C(reset)' --abbrev-commit
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[include]
	path = ~/.gitconfig.local
