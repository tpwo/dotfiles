#!/usr/bin/python3
"""Removes PDF password using qpdf utility (available via apt)."""
import argparse
import shutil
import subprocess

parser = argparse.ArgumentParser(
    description='Remove a PDF password using the qpdf utility.'
)
parser.add_argument('password')
parser.add_argument('file')
args = parser.parse_args()

if shutil.which('qpdf') is None:
    print("'qpdf' not found. Aborting...")
    raise SystemExit(1)

output = args.file[:-4] if args.file.endswith('.pdf') else args.file
output += '_decrypted.pdf'
result = subprocess.run(
    ['qpdf', f'-password={args.password}', '-decrypt', args.file, output]
)
if result.returncode != 0:
    raise SystemExit(result.returncode)

print(f'{output} saved')
