#!/usr/bin/bash
#
# Removes PDF password using qpdf utility (available via apt).
set -euo pipefail

password=$1
file=$2
output="${file%.pdf}_decrypted.pdf"

_have() { type "$1" &> /dev/null; }
if _have qpdf; then
  qpdf -password="$password" -decrypt "$file" "$output"
  echo "$output saved"
else
  echo "'qpdf' not found. Aborting..."
  exit 1
fi
